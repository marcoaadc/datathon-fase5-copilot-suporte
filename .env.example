# Copie para .env e ajuste. Todas as chaves tem default; so as de LLM sao necessarias para a
# resposta gerada (sem elas o /chat devolve os trechos do manual, em modo extrativo).
# Prefixo COPILOT_ (pydantic-settings). O arquivo .env nunca e versionado.

# --- LLM: defina UMA das chaves ---------------------------------------------------------------
# OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=...
# auto = usa o provedor cuja chave existir | openai | gemini | offline
COPILOT_LLM_PROVIDER=auto
# Os provedores descontinuam modelos com frequencia: ajuste o nome ao que a sua conta oferece e
# confira com `python -m supportcopilot.pipelines.check_llm`.
COPILOT_OPENAI_MODEL=gpt-4o-mini
COPILOT_GEMINI_MODEL=gemini-3.5-flash
COPILOT_LLM_TEMPERATURE=0
COPILOT_LLM_MAX_OUTPUT_TOKENS=600
COPILOT_LLM_TIMEOUT_SECONDS=30

# --- RAG ---------------------------------------------------------------------------------------
COPILOT_CHUNK_SIZE=700
COPILOT_CHUNK_OVERLAP=120
COPILOT_RETRIEVAL_K=4
COPILOT_MIN_RELEVANCE=0.35
# "hashing" troca o modelo multilingue por um embedding lexical sem download (modo degradado)
COPILOT_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# --- Contrato e triagem -------------------------------------------------------------------------
COPILOT_MAX_TEXT_CHARS=1000
COPILOT_TECHNICAL_THRESHOLD=0.5
COPILOT_LOW_CONFIDENCE_THRESHOLD=0.40

# --- Guardrails ---------------------------------------------------------------------------------
# Termos proibidos adicionais (JSON): COPILOT_EXTRA_BLOCKED_TERMS=["concorrente x"]
COPILOT_GROUNDING_CHECK=true

# --- Monitor de drift da API --------------------------------------------------------------------
COPILOT_DRIFT_WINDOW_SIZE=500
COPILOT_DRIFT_MIN_SAMPLES=200
COPILOT_PSI_WARNING=0.10
COPILOT_PSI_CRITICAL=0.25

# --- MLflow (vazio = treino sem rastreamento) ---------------------------------------------------
COPILOT_MLFLOW_TRACKING_URI=http://127.0.0.1:5000
COPILOT_MLFLOW_EXPERIMENT=copilot-triagem

# --- Seguranca da API (vazio = sem autenticacao; use so localmente) -----------------------------
# COPILOT_API_KEY=troque-por-um-segredo-longo
COPILOT_RATE_LIMIT_PER_MINUTE=120
# COPILOT_CORS_ORIGINS=["https://app.exemplo.com"]

# --- Logs ---------------------------------------------------------------------------------------
COPILOT_LOG_LEVEL=INFO
COPILOT_LOG_JSON=false
